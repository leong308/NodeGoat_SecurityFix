# (01) This is a template, not a file containing real credentials. Copy it to .env and replace secrets
# (01) SESSION_SECRET signs session cookies so altered cookies can be detected
SESSION_SECRET=replace-with-random-at-least-32-character-secret
# (01) DATA_KEY is reserved for Fix 10
DATA_KEY=replace-with-64-hex-characters-at-stage-10
# (01) These passwords are read only when creating the three demo users
# (01) Fix 01 still stores them as plaintext.
# (01) Password hashing and stronger authentication arrive in Fix 05.
ADMIN_PASSWORD=choose-a-unique-demo-passphrase-at-least-15-characters
USER1_PASSWORD=choose-another-unique-demo-passphrase-at-least-15-characters
USER2_PASSWORD=choose-third-unique-demo-passphrase-at-least-15-characters
# (01) Fix 01 serves local HTTP and does not enforce PUBLIC_ORIGIN or HTTPS_ONLY
# (01) HTTPS deployment is addressed in Fix 11.
PUBLIC_ORIGIN=http://localhost:4000
HTTPS_ONLY=false
