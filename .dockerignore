# (01) Docker ignores these paths when sending files to the image builder.
# (01) Exclude Git history, local packages, .env secrets, remediation tools and
# (01) captured evidence. Dependencies are installed inside the image using npm ci.
.git
node_modules
.env
kit
evidence
# (11) Mount TLS files at runtime and exclude generated reports from the image.
certs
**/*.key
**/*.pem
**/*.pfx
**/*.p12
